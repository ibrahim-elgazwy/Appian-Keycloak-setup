  "clients": [
    {
      "clientId": "aqarat-sso",
      "name": "AQARAT SSO (Keycloak broker)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${NAS_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "${AQ_KEYCLOAK_URL}/realms/aqarat-poc/broker/nas/endpoint"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "false",
        "id.token.signed.response.alg": "RS256",
        "post.logout.redirect.uris": "${AQ_KEYCLOAK_URL}/realms/aqarat-poc/broker/nas/endpoint/logout_response",
        "backchannel.logout.session.required": "false"
      },
      "protocolMappers": [
        {
          "name": "acr (NAS level of assurance)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "acr",
            "claim.value": "urn:nas:loa:substantial",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "amr",
            "claim.value": "[\"pwd\"]",
            "jsonType.label": "JSON",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "phone",
        "nas_identity"
      ],
      "optionalClientScopes": []
    }
  ],
