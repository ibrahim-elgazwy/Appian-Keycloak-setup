  "authenticationFlows": [
    {
      "id": "5f0c9d2e-7a41-4b8e-9c3d-1a2b3c4d5e60",
      "alias": "nas-only browser",
      "description": "Citizen clients: existing SSO session, else straight to NAS (no Keycloak login page).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
