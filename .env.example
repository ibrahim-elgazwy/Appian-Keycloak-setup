# Copy to .env and fill in. .env is local only - never commit or share it.
KC_DB_PASSWORD=
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=
# Client secret of client aqarat-sso in the mock NAS; the aqarat-poc broker `nas` uses the same value.
NAS_CLIENT_SECRET=
# Password for all mock NAS test personas (28463400001, 29035600002, 29581800003, 30163400004, noqid.test, 28863400006,
# 28463400007 = Role API error, 28463400008 = Role API too slow).
MOCK_USER_PASSWORD=
# Password for local_dev.tester (DEV ONLY direct-grant user for scripted checks).
DEV_TESTER_PASSWORD=
# Appian-API-Key the mock backend uses for its server-side Appian Web API calls (production: Key Vault).
APPIAN_API_KEY=mock-appian-api-key
# Service key Keycloak sends to the external Role API (mock: mock-api /internal/v1/users/{qid}/roles). Random, e.g. openssl rand -hex 24.
ROLE_API_KEY=
